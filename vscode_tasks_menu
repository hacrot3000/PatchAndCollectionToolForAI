#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC_DIR="$SCRIPT_DIR/vscode_tasks_menu_go"
BUILD_DIR="$SRC_DIR/.build"
BIN="$BUILD_DIR/vscode_tasks_menu"
SOURCE_REVISION_FILE="$BUILD_DIR/source.revision"

REPOSITORY="hacrot3000/PatchAndCollectionToolForAI"
BRANCH="main"
API_URL="https://api.github.com/repos/$REPOSITORY/commits/$BRANCH"
ARCHIVE_BASE_URL="https://codeload.github.com/$REPOSITORY/tar.gz"
MAX_ARCHIVE_BYTES=$((128 * 1024 * 1024))

die() {
    echo "ERROR: $*" >&2
    exit 1
}

source_complete() {
    [[ -f "$SRC_DIR/go.mod" ]] &&
    [[ -f "$SRC_DIR/cmd/vscode_tasks_menu/main.go" ]] &&
    [[ -f "$SRC_DIR/internal/selfupdate/selfupdate.go" ]] &&
    [[ -f "$SRC_DIR/web/assets.go" ]]
}

http_stdout() {
    local url="$1"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --retry 2 --connect-timeout 10 --max-time 30             -H 'Accept: application/vnd.github+json'             -H 'User-Agent: vscode_tasks_menu-self-install'             "$url"
        return
    fi
    if command -v wget >/dev/null 2>&1; then
        wget -qO- --timeout=30             --header='Accept: application/vnd.github+json'             --user-agent='vscode_tasks_menu-self-install'             "$url"
        return
    fi
    die "Self-install cần curl hoặc wget để tải source từ GitHub."
}

http_download() {
    local url="$1"
    local output="$2"
    if command -v curl >/dev/null 2>&1; then
        curl -fL --retry 2 --connect-timeout 10 --max-time 120             -H 'User-Agent: vscode_tasks_menu-self-install'             -o "$output" "$url"
        return
    fi
    if command -v wget >/dev/null 2>&1; then
        wget -q --timeout=120             --user-agent='vscode_tasks_menu-self-install'             -O "$output" "$url"
        return
    fi
    die "Self-install cần curl hoặc wget để tải source từ GitHub."
}

remote_revision() {
    local json revision
    json="$(http_stdout "$API_URL")" || die "Không lấy được revision mới nhất từ GitHub."
    revision="$(printf '%s\n' "$json" | grep -oE '"sha"[[:space:]]*:[[:space:]]*"[0-9a-fA-F]{40}"' | head -n 1 | sed -E 's/.*"([0-9a-fA-F]{40})".*/\1/' || true)"
    [[ "$revision" =~ ^[0-9a-fA-F]{40}$ ]] || die "GitHub trả về revision không hợp lệ."
    printf '%s\n' "$revision"
}

bootstrap_source() {
    source_complete && return 0
    [[ ! -L "$SRC_DIR" ]] || die "$SRC_DIR là symlink; từ chối self-install để tránh ghi source ra ngoài thư mục tool."
    command -v tar >/dev/null 2>&1 || die "Self-install cần lệnh tar."

    echo "Self-install: thiếu source vscode_tasks_menu_go; đang tải từ GitHub..."
    local revision tmp_root archive extract_root go_mod staged_source archive_size pristine_install
    revision="$(remote_revision)"
    pristine_install=0
    tmp_root="$(mktemp -d "$SCRIPT_DIR/.vscode_tasks_menu-install.XXXXXX")"
    trap 'rm -rf -- "$tmp_root"' EXIT
    archive="$tmp_root/source.tar.gz"
    extract_root="$tmp_root/extract"
    mkdir -p "$extract_root"

    http_download "$ARCHIVE_BASE_URL/$revision" "$archive"
    archive_size="$(wc -c < "$archive" | tr -d '[:space:]')"
    [[ "$archive_size" =~ ^[0-9]+$ ]] || die "Không xác định được kích thước archive self-install."
    (( archive_size <= MAX_ARCHIVE_BYTES )) || die "Archive self-install vượt giới hạn 128 MiB."

    tar --no-same-owner --no-same-permissions -xzf "$archive" -C "$extract_root"
    go_mod="$(find "$extract_root" -type f -path '*/vscode_tasks_menu_go/go.mod' -print -quit)"
    [[ -n "$go_mod" ]] || die "Archive GitHub thiếu vscode_tasks_menu_go/go.mod."
    staged_source="$(dirname "$go_mod")"
    [[ -f "$staged_source/cmd/vscode_tasks_menu/main.go" ]] || die "Archive GitHub thiếu cmd/vscode_tasks_menu/main.go."
    [[ -f "$staged_source/internal/selfupdate/selfupdate.go" ]] || die "Archive GitHub thiếu self-update source."
    [[ -f "$staged_source/web/assets.go" ]] || die "Archive GitHub thiếu embedded web assets."

    if [[ ! -e "$SRC_DIR" ]]; then
        mv "$staged_source" "$SRC_DIR"
        pristine_install=1
    else
        mkdir -p "$SRC_DIR"
        # Chỉ bổ sung file còn thiếu; không ghi đè source/local changes đang có.
        cp -a -n "$staged_source/." "$SRC_DIR/"
    fi
    source_complete || die "Self-install hoàn tất tải nhưng source vẫn chưa đầy đủ."

    mkdir -p "$BUILD_DIR"
    if [[ "$pristine_install" == "1" ]]; then
        printf '%s\n' "$revision" > "$SOURCE_REVISION_FILE"
        chmod 600 "$SOURCE_REVISION_FILE"
        echo "Self-install: source revision ${revision:0:12} đã sẵn sàng."
    else
        # Source hỗn hợp có thể chứa local changes; không được giả nhận SHA remote.
        rm -f "$SOURCE_REVISION_FILE"
        echo "Self-install: đã bổ sung file còn thiếu; giữ nguyên source hiện có (revision=dev)."
    fi
    trap - EXIT
    rm -rf -- "$tmp_root"
}

source_revision_for_build() {
    [[ -f "$SOURCE_REVISION_FILE" ]] || return 0
    local revision
    revision="$(tr -d '[:space:]' < "$SOURCE_REVISION_FILE")"
    [[ "$revision" =~ ^[0-9a-fA-F]{40}$ ]] || return 0

    # Marker chỉ đáng tin khi source chưa bị sửa sau lần bootstrap.
    if find "$SRC_DIR" -type f         \( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' -o -path '*/web/*' \)         ! -path "$BUILD_DIR/*" -newer "$SOURCE_REVISION_FILE" -print -quit | grep -q .; then
        return 0
    fi
    printf '%s\n' "$revision"
}

if ! command -v go >/dev/null 2>&1; then
    echo "ERROR: Go toolchain không có trong PATH." >&2
    exit 127
fi

bootstrap_source
mkdir -p "$BUILD_DIR"

needs_build=0
if [[ ! -x "$BIN" ]]; then
    needs_build=1
elif find "$SRC_DIR" -type f     \( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' -o -path '*/web/*' \)     ! -path "$BUILD_DIR/*" -newer "$BIN" -print -quit | grep -q .; then
    needs_build=1
fi

if [[ "$needs_build" == "1" ]]; then
    tmp="$BIN.tmp.$$"
    revision="$(source_revision_for_build || true)"
    build_args=(build -trimpath -o "$tmp")
    if [[ -n "$revision" ]]; then
        build_args+=(-ldflags "-X main.buildRevision=$revision")
    fi
    build_args+=(./cmd/vscode_tasks_menu)
    (
        cd "$SRC_DIR"
        GOPROXY=off GOSUMDB=off go "${build_args[@]}"
    )
    chmod +x "$tmp"
    mv -f "$tmp" "$BIN"
    if [[ -n "$revision" ]]; then
        printf '%s\n' "$revision" > "$BIN.revision.tmp"
        chmod 600 "$BIN.revision.tmp"
        mv -f "$BIN.revision.tmp" "$BIN.revision"
    else
        rm -f "$BIN.revision"
    fi
fi

exec "$BIN" --workspace "$PWD" "$@"
