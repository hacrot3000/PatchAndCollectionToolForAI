        "known_tool_version",
        "sync_token",
        "agent_id",
        "request_full_sync"
      ]
    },
    "project": {
      "description": "Optional on legacy requests; required for new AI requests. Both key and id must match local project identity before collecting.",
      "allowed_fields": [
        "key",
        "id"
      ]
    }
  },
  "limits": {
    "allowed_fields": [
