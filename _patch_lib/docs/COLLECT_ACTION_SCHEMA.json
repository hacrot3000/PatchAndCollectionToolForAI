    "database_select": {
      "description": "SELECT-only database evidence collection using an active query builder. Raw SQL is not accepted. Supports SQLite read-only files and MySQL local/SSH-tunnel profiles, joins, nested AND/OR conditions, subqueries, GROUP BY/HAVING, functions, CASE, window clauses, ORDER BY and bounded streaming CSV/JSONL output.",
      "required": [
        "type",
        "profile",
        "select",
        "from"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "profile",
        "select",
        "from",
        "joins",
        "where",
        "group_by",
        "having",
        "order_by",
        "distinct",
        "limit",
        "offset",
        "format",
        "max_rows",
        "max_bytes",
        "timeout_sec",
        "chunk_rows",
        "must_return_rows"
      ],
      "raw_sql_allowed": false,
      "statement_class": "SELECT",
      "profile_file": "tools/db_profiles.local.json (local-only; never included in a request ZIP)"
    },
    "git": {
      "description": "Strict allowlist-only Git inspection plus safe local-branch switch. No raw Git command/argv escape hatch; mutation commands such as add/commit/merge/rebase/reset/push/pull/cherry-pick/checkout are forbidden.",
      "required": [
        "type"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "repo",
        "operations",
        "sections",
        "log_entries"
      ],
      "compatibility_note": "Legacy sections/log_entries remain accepted and normalize to v6.20.0 safe operations.",
      "operations": {
        "allowed": [
          "status",
          "current_branch",
          "branches",
          "log",
          "show",
          "diff_worktree",
          "diff_staged",
          "diff_refs",
          "diff_ref_worktree",
          "switch"
        ],
        "forbidden_mutations": [
          "add",
          "commit",
          "merge",
          "rebase",
          "reset",
          "push",
          "pull",
          "cherry-pick",
          "checkout"
        ],
        "raw_escape_fields_forbidden": [
          "argv",
          "command",
          "raw_git"
        ],
        "switch_contract": "existing local branch only; clean worktree/index/untracked; no create/force/detach; --no-guess; hooks disabled"
      }
    },
    "command": {
      "description": "Run one bounded whitelist-only read-only command to collect console evidence. transport=local uses project cwd; transport=ssh uses an exact saved TaskDeck SSH profile name (ask user when unknown). No shell, Python, scripts or mutating find flags. SSH absolute operands may use only these fixed data roots or descendants: /data, /srv, /opt, /var/log, /var/www, /var/data, /mnt, /media, /app, /apps, /logs, /storage, /backup, /backups. Relative operands retain login-directory semantics. Use only absolute whitelist operands or only relative operands in each command; no '..', prefix lookalikes or arbitrary shell. The SSH bridge resolves absolute targets remotely with realpath -e and rejects targets outside the whitelist; a missing target or missing realpath fails closed. File readers require regular files. This is not a filesystem sandbox; avoid collecting credentials or unrelated sensitive data. Local COLLECT stays project-relative. Example SSH argv: [\"grep\",\"-nriF\",\"--\",\"orderId=123\",\"/data/logs\"].",
      "required": [
        "type",
        "argv"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "transport",
        "profile_name",
        "argv",
        "cwd",
        "timeout_seconds",
        "max_output_bytes"
      ],
      "transport_allowed": [
        "local",
        "ssh"
      ],
      "local_whitelist": [
        "pwd",
        "ls",
        "tree",
        "find",
        "grep",
        "rg",
        "cat",
        "head",
        "tail",
        "wc",
        "nl",
        "sed"
      ],
      "forbidden": [
        "scripts",
        "shell",
        "python",
        "find -exec",
        "find -delete",
        "pipes",
        "redirection"
      ],
      "limits": {
        "timeout_seconds": [
          1,
          120
        ],
        "max_output_bytes": [
          1024,
          65536
        ]
      }
    }
  },
