{
  "schema_version": 1,
  "tool_version": "6.19.3",
  "request": {
    "type": "object",
    "required": [
      "actions"
    ],
    "allowed_fields": [
      "id",
      "title",
      "ai_context",
      "actions",
      "limits"
    ],
    "ai_context": {
      "description": "Optional AI/tool synchronization metadata. A current sync_token suppresses repeated AI_TOOL_SYNC documentation until the tool/document fingerprint changes.",
      "allowed_fields": [
        "known_tool_version",
        "sync_token",
        "agent_id",
        "request_full_sync"
      ]
    }
  },
  "limits": {
    "allowed_fields": [
      "max_file_bytes",
      "max_total_bytes",
      "max_files",
      "max_report_bytes",
      "max_search_files",
      "max_search_file_bytes",
      "max_decompile_file_bytes"
    ],
    "defaults": {
      "max_file_bytes": 8388608,
      "max_total_bytes": 268435456,
      "max_files": 5000,
      "max_report_bytes": 16777216,
      "max_search_files": 250000,
      "max_search_file_bytes": 67108864,
      "max_decompile_file_bytes": 536870912
    }
  },
  "actions": {
    "pack": {
      "description": "Collect exact current bytes for known project-relative regular files.",
      "required": [
        "type",
        "paths"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "paths"
      ]
    },
    "zip": {
      "description": "Historical alias for pack; collect exact current bytes for known project-relative regular files.",
      "required": [
        "type",
        "paths"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "paths"
      ]
    },
    "overview": {
      "description": "Produce a bounded read-only project/tree/file-type overview.",
      "required": [
        "type"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "path",
        "tree_depth"
      ]
    },
    "ls": {
      "description": "Historical bounded directory listing.",
      "required": [
        "type"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "path",
        "max_entries"
      ]
    },
    "tree": {
      "description": "Historical bounded recursive tree listing.",
      "required": [
        "type"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "path",
        "max_depth",
        "max_entries"
      ]
    },
    "find": {
      "description": "Coverage-aware filename/path glob discovery. Patterns match basename, each requested scope-relative path, and project-relative path; **/ matches zero or more directories. Discovery traversal uses max_search_files, not the collection max_files quota.",
      "required": [
        "type",
        "patterns"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "paths",
        "patterns",
        "collect",
        "max_results"
      ]
    },
    "search": {
      "description": "Coverage-aware filesystem-first text/regex search with independent fallback verification, zero-match diagnostics, anchors, and must_find assertions.",
      "required": [
        "type",
        "query"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "query",
        "regex",
        "paths",
        "context_lines",
        "max_matches",
        "backend",
        "source_scope",
        "filesystem",
        "respect_gitignore",
        "follow_symlinks",
        "must_find",
        "diagnose_on_zero",
        "fallback_search",
        "verify_nonzero_with_fallback",
        "report_coverage",
        "report_skipped_dirs",
        "module_discovery",
        "anchor_paths",
        "expected_files"
      ]
    },
    "search_files": {
      "description": "Compatibility alias for coverage-aware search used by historical request ZIPs.",
      "required": [
        "type",
        "query"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "query",
        "regex",
        "paths",
        "context_lines",
        "max_matches",
        "backend",
        "source_scope",
        "filesystem",
        "respect_gitignore",
        "follow_symlinks",
        "must_find",
        "diagnose_on_zero",
        "fallback_search",
        "verify_nonzero_with_fallback",
        "report_coverage",
        "report_skipped_dirs",
        "module_discovery",
        "anchor_paths",
        "expected_files"
      ]
    },
    "content": {
      "description": "Compatibility alias for coverage-aware source-content search used by historical request ZIPs.",
      "required": [
        "type",
        "query"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "query",
        "regex",
        "paths",
        "context_lines",
        "max_matches",
        "backend",
        "source_scope",
        "filesystem",
        "respect_gitignore",
