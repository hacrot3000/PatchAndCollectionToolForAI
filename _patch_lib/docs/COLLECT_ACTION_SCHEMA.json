      "max_total_bytes",
      "max_files",
      "max_report_bytes",
      "max_search_files",
      "max_search_file_bytes",
      "max_decompile_file_bytes"
    ],
    "defaults": {
      "max_file_bytes": 8388608,
      "max_total_bytes": 268435456,
      "max_files": 5000,
      "max_report_bytes": 16777216,
      "max_search_files": 250000,
      "max_search_file_bytes": 67108864,
      "max_decompile_file_bytes": 536870912
    },
    "hard_maximum": {
      "max_file_bytes": 67108864,
      "max_total_bytes": 536870912,
      "max_files": 20000,
      "max_report_bytes": 67108864,
      "max_search_files": 1000000,
      "max_search_file_bytes": 268435456,
      "max_decompile_file_bytes": 2147483648
    }
  },
