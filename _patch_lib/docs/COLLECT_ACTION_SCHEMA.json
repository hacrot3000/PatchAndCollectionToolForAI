        "diagnose_on_zero",
        "fallback_search",
        "verify_nonzero_with_fallback",
        "report_coverage",
        "report_skipped_dirs",
        "module_discovery",
        "anchor_paths",
        "expected_files"
      ]
    },
    "research": {
      "description": "Historical combined research action: overview plus coverage-aware search.",
      "required": [
        "type",
        "query"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "query",
        "regex",
        "path",
        "paths",
        "context_lines",
        "max_matches",
        "tree_depth",
        "backend",
        "source_scope",
        "filesystem",
        "respect_gitignore",
        "follow_symlinks",
        "must_find",
        "diagnose_on_zero",
        "fallback_search",
        "verify_nonzero_with_fallback",
        "report_coverage",
        "report_skipped_dirs",
        "module_discovery",
        "anchor_paths",
        "expected_files"
      ]
    },
    "file": {
      "description": "Read a project-relative text file or selected line range.",
      "required": [
        "type",
        "path"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "path",
        "start_line",
        "end_line"
      ]
    },
    "range": {
      "description": "Historical line-range reader for one project-relative text file.",
      "required": [
        "type",
        "path",
        "start_line",
        "end_line"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "path",
        "start_line",
        "end_line"
      ]
    },
    "head": {
      "description": "Historical bounded first-lines reader.",
      "required": [
        "type",
        "path"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "path",
        "lines"
      ]
    },
    "tail": {
      "description": "Historical bounded last-lines reader.",
      "required": [
        "type",
        "path"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "path",
        "lines"
      ]
    },
    "symbol": {
