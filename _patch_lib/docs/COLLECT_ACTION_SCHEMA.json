        "verify_nonzero_with_fallback",
        "report_coverage",
        "report_skipped_dirs",
        "module_discovery",
        "anchor_paths",
        "expected_files"
      ]
    },
    "callgraph": {
      "description": "Historical heuristic caller/callee graph around a symbol with coverage-aware caller discovery.",
      "required": [
        "type",
        "symbol"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "symbol",
        "paths",
        "path",
        "context_lines",
        "max_callers",
        "max_callees",
        "max_occurrences"
      ]
    },
    "dependencies": {
      "description": "Historical bounded source dependency/import/include inventory.",
      "required": [
        "type"
      ],
      "allowed_fields": [
        "id",
        "title",
        "type",
        "paths",
        "path",
        "max_results",
        "dependency_depth"
      ]
    },
    "directory": {
      "description": "Historical bounded recursive directory collector with include/exclude glob filters; patterns are scope-relative/project-relative and **/ matches zero or more directories.",
      "required": [
        "type",
        "path"
      ],
      "allowed_fields": [
        "id",
