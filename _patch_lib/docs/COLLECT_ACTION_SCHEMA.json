  "git_sections": [
    "status",
    "log",
    "diff_stat",
    "diff"
  ],
  "compatibility": {
    "public_collect_cli": "SUPERSEDED_BY_ZERO_ARGUMENT_ZIP_QUEUE",
    "historical_action_aliases": {
      "zip": "pack",
      "search_files": "search",
      "content": "search",
      "ida": "decompile",
      "ghidra": "decompile"
    }
  }
